# Application
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://facultyflow:password@localhost:5433/facultyflow_db?schema=public"

# Authentication
# Generate a secure random string for JWT_SECRET (e.g., openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_for_development_only

# AI Assistant Configuration (Optional)
# Supported Providers: google
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_api_key_here
